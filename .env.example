# ==========================================
# Aurelia Luxe Luxury Makeup Artistry Platform
# Environment Configuration (.env.example)
# ==========================================

# 1. Tiger Cloud Database (PostgreSQL)
# Obtain your connection URI from your Tiger Cloud / Timescale Console:
# Format: postgres://<username>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_URL="postgres://tsdbadmin:your_secure_password@ts-xxxx.cloud.tigerdata.com:5432/postgres?sslmode=require"

# 2. Authentication Secrets (Used for JWT and Admin Session Cookies)
AUTH_SECRET="super_secret_jwt_key_aurelia_luxe_minimum_32_characters"
ADMIN_SESSION_COOKIE="aurelia_admin_session"

# Default Demo Admin Credentials (Seed data)
# Owner: aurelia@aurelialuxe.com / LuxeOwner2026!
# Editor: assistant@aurelialuxe.com / LuxeStudio2026!

# 3. Media Object Storage (Optional for external CDN, defaults to local Next.js /public/uploads)
# AWS_S3_BUCKET="aurelia-luxe-media"
# AWS_ACCESS_KEY_ID="your_aws_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret"
# AWS_REGION="eu-west-2"

# 4. Official Instagram Graph API (Optional for automated token sync)
# INSTAGRAM_CLIENT_ID="your_instagram_app_id"
# INSTAGRAM_CLIENT_SECRET="your_instagram_app_secret"
# INSTAGRAM_ACCESS_TOKEN="your_long_lived_user_token"

# 5. Studio Public Contact & Concierge
NEXT_PUBLIC_STUDIO_NAME="Aurelia Luxe"
NEXT_PUBLIC_WHATSAPP="+447946091200"
NEXT_PUBLIC_INSTAGRAM="aurelialuxemakeup"
